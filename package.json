{
  "name": "erp-siparis",
  "version": "1.0.0",
  "description": "SQLite tabanli masaustu siparis yonetimi uygulamasi",
  "main": "electron/main.js",
  "author": "Ahmet Emirhan Kanyilmaz",
  "license": "MIT",
  "scripts": {
    "vendor": "node scripts/prepare-vendor.js",
    "start": "npm run vendor && electron .",
    "smoke": "npm run vendor && electron . --smoke-test",
    "dist:win": "npm run vendor && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "chart.js": "4.5.1",
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.ahmetkanyilmaz.erpsiparis",
    "productName": "ERP Sipariş",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "vendor/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "ERP-Siparis-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ERP Sipariş"
    },
    "portable": {
      "artifactName": "ERP-Siparis-Portable-${version}-${arch}.${ext}"
    }
  }
}
